# ─── Server Configuration ───────────────────────────────────────
PORT=8001
HOST=0.0.0.0

# ─── Qdrant Vector DB ───────────────────────────────────────
# Local Qdrant (default):  http://localhost:6333
# Qdrant Cloud:            https://your-cluster.qdrant.tech
QDRANT_URL=http://localhost:6333

# Only needed for Qdrant Cloud — leave blank for local
QDRANT_API_KEY=

# Collection name in Qdrant
QDRANT_COLLECTION=school_textbooks

# ─── Google AI (Embeddings & LLM) ───────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-3.1-flash-lite

# ─── Cohere Reranker ─────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here

# ─── Cloudinary (Optional, for persistent diagram CDN) ───────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Ingestion Settings ──────────────────────────────────────
# Default board name if not specified in chapters.json
DEFAULT_BOARD=CBSE

# Minimum image size in pixels to extract from PDF (filters out icons/bullets)
MIN_IMAGE_SIZE_PX=120
